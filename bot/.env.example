# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace_me

# HTTPS URL where you host the webapp folder (index.html at root)
# Example: https://your-domain.com/weather
WEBAPP_URL=https://example.com

# Optional: log Telegram user IDs to a separate JSONL file (one event per line)
# USER_IDS_LOG_ENABLED=1
# USER_IDS_LOG_PATH=user_ids.jsonl

# Optional: notify admin when a new user uses the bot/webapp
# ADMIN_CHAT_ID=123456789
# For channels it's usually like: -1001234567890 (invite links like https://t.me/+... won't work here)
ADMIN_NOTIFY_NEW_USER_ENABLED=1
# If you don't know the channel chat_id, enable auto-detect and post any message in the channel (bot must be admin):
ADMIN_CHAT_ID_AUTO=1
ADMIN_STATE_PATH=admin_state.json
SEEN_USERS_PATH=seen_users.json
